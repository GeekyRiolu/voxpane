#!/usr/bin/env python3
"""Run voxpane straight from a clone, without installing.

Prefers the project's ``.venv`` interpreter when present, so from-source runs get
the optional extras (faster-whisper, webrtcvad) installed there. Falls back to the
current interpreter with ``src/`` on the path. Once installed
(``uv tool install .``), prefer the ``voxpane`` entry point on PATH.
"""

import os
import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parent.parent
_VENV_PY = _ROOT / ".venv" / "bin" / "python"
if _VENV_PY.exists() and Path(sys.executable).resolve() != _VENV_PY.resolve():
    os.execv(str(_VENV_PY), [str(_VENV_PY), str(Path(__file__).resolve()), *sys.argv[1:]])

sys.path.insert(0, str(_ROOT / "src"))

from voxpane.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
