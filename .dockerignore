# Keep the build context minimal — only what the image actually needs.
.git
.gitignore
.venv
venv
**/__pycache__
**/*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache

# Docs / dev / CI — not needed inside the image
tests
docs
.github
.claude
CONTRIBUTING*
*.md
!README.md

# Build artifacts, models, stray media
dist
build
models
*.onnx
*.onnx.json
Gemini_*
*.png
*.gif
!ui/eww/pet/*.png
!ui/eww/pet/*.gif
