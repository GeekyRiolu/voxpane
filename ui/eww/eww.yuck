;; voxpane pixel-pet overlay for eww. Launch: voxpane overlay  (stop: voxpane overlay stop)
;;
;; A little pixel critter that lives in the screen corner and reacts to voxpane:
;; sleeping when idle, ears-up when listening, mouth open when speaking, plus a
;; speech bubble with the transcript. It SLIDES UP when hands-free listening is
;; turned on (SUPER ALT V) and slides back down when it's off. Swap the art in
;; ~/.config/voxpane/pet/.

;; ONE streaming source instead of per-field polling: `voxpane status --watch` is a
;; single process that prints the status JSON only when it changes, so the pet costs
;; ~0 CPU (polling spawned a fresh Python ~14x/second — ~85% of a core).
(deflisten vst
  :initial '{"state":"idle","sprite":"","detail":"","running":"0"}'
  "voxpane status --watch")

(defwidget vox-pet []
  ;; revealer: the pet slides up into the corner when the listener is on and slides
  ;; back down out of view when it's off.
  (revealer :transition "slideup" :duration "350ms" :reveal {vst.running == "1"}
    (box :class "vox-pet vox-${vst.state}" :orientation "v" :space-evenly false :spacing 2 :halign "center"
      (label :class "vox-say" :text {vst.detail} :limit-width 26 :wrap true :visible {vst.detail != ""})
      (image :class "vox-sprite" :path {vst.sprite} :image-width 88 :image-height 78))))

(defwindow voxpane
  :monitor 0
  :geometry (geometry :x "26px" :y "22px" :anchor "bottom right")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (vox-pet))
