;; voxpane on-screen overlay for eww (ElKowars wacky widgets).
;; Launch it with:  voxpane overlay      (stop:  voxpane overlay stop)
;;
;; It polls `voxpane status` (JSON: {state, class, detail, tooltip}) 5×/sec and
;; shows a Siri-style pill at bottom-centre while voxpane is active, with the live
;; transcript. eww syntax varies by version — if it doesn't render, adjust the jq
;; calls / geometry; the state it needs is all in `voxpane status`.

(defpoll vox :interval "200ms"
             :initial '{"state":"idle","detail":"","class":"idle"}'
             "voxpane status")

(defwidget vox-pill []
  (box :class "vox-pill vox-${vox.state}" :space-evenly false :spacing 8
    (label :class "vox-dot" :text "●")
    (label :class "vox-text" :limit-width 64 :show-truncated true
           :text {vox.detail != "" ? vox.detail : vox.tooltip})))

(defwindow voxpane
  :monitor 0
  :geometry (geometry :y "48px" :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (revealer :transition "slideup" :duration "220ms" :reveal {vox.state != "idle"}
    (vox-pill)))
