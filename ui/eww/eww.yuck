;; voxpane on-screen overlay for eww. Launch:  voxpane overlay   (stop: voxpane overlay stop)
;;
;; Per-field polls (plain strings) so it does NOT depend on eww parsing JSON.
;; No revealer: the pill always has a surface (reliable on Hyprland layer-shell)
;; and is hidden when idle via opacity in eww.scss (.vox-idle).

(defpoll vstate :interval "200ms" :initial "idle" "voxpane status --field state")
(defpoll vtext  :interval "200ms" :initial ""     "voxpane status --field detail")

(defwidget vox-pill []
  (box :class "vox-pill vox-${vstate}" :space-evenly false :spacing 8
    (label :class "vox-dot" :text "●")
    (label :class "vox-text" :limit-width 64 :text {vtext != "" ? vtext : vstate})))

(defwindow voxpane
  :monitor 0
  :geometry (geometry :y "48px" :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (vox-pill))
